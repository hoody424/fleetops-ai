# =============================================================================
# fleetops-ai — Environment Configuration (.env.example)
# Copy to .env for Docker Compose or local development.
# =============================================================================

# Server & URLs
PORT=3000
NODE_ENV=production
PUBLIC_URL=http://localhost:3000

# Database & Cache
DATABASE_URL=postgresql://fleetops:fleetops_secret@postgres:5432/fleetops
POSTGRES_USER=fleetops
POSTGRES_PASSWORD=fleetops_secret
POSTGRES_DB=fleetops
REDIS_URL=redis://redis:6379

# Security & Encryption (Generate with: openssl rand -hex 32)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# Authentication & SSO (Authentik / Traefik ForwardAuth / OIDC)
# Set TRUST_FORWARD_AUTH=true when deployed behind Authentik / Traefik ForwardAuth
TRUST_FORWARD_AUTH=false
FORWARD_AUTH_ADMIN_GROUP=Infrastructure Admins
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# AI Subscription & Provider Paths
AI_PROFILES_DIR=/data/ai-profiles
CLAUDE_CLI_PATH=claude
GEMINI_CLI_PATH=gemini

# Optional Local / Cloud Fallback LLM (OpenAI-compatible / Ollama / llama.cpp)
FALLBACK_LLM_URL=http://localhost:11434/v1
FALLBACK_LLM_MODEL=qwen3.5:9b
FALLBACK_LLM_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional Guacamole Daemon (guacd) for Windows Graphical Desktop (RDP in browser)
GUACD_HOST=guacd
GUACD_PORT=4822

# Optional External Seed File (JSON file with initial hosts/groups/keys, ignored by git)
SEED_CONFIG_PATH=
