{
  "slug": "ftp",
  "name": "FTP / SFTP",
  "icon": "FolderUp",
  "category": "File Sharing",
  "check_type": "tcp",
  "inventory_match": ["vsftpd", "proftpd", "pure-ftpd", "ftp"],
  "defaults": {
    "port": 21,
    "timeout": 5,
    "ssl": false,
    "warn_days": 0,
    "response_pattern": "220",
    "starttls": "ftp"
  },
  "fields": [
    {
      "name": "port",
      "label": "Port",
      "type": "number",
      "required": true
    },
    {
      "name": "ssl",
      "label": "SSL / TLS",
      "type": "boolean"
    },
    {
      "name": "warn_days",
      "label": "Certificate Warning (days)",
      "type": "select",
      "options": [
        "0",
        "7",
        "14",
        "30",
        "60",
        "90"
      ]
    },
    {
      "name": "timeout",
      "label": "Timeout (s)",
      "type": "number"
    }
  ]
}
