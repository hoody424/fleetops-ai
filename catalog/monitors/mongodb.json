{
  "slug": "mongodb",
  "name": "MongoDB",
  "icon": "Database",
  "category": "Database",
  "check_type": "tcp",
  "inventory_match": ["mongod", "mongodb"],
  "defaults": {
    "port": 27017,
    "timeout": 5,
    "ssl": false,
    "warn_days": 0
  },
  "fields": [
    {
      "name": "port",
      "label": "Port",
      "type": "number",
      "required": true
    },
    {
      "name": "ssl",
      "label": "SSL / TLS",
      "type": "boolean"
    },
    {
      "name": "warn_days",
      "label": "Certificate Warning (days)",
      "type": "select",
      "options": [
        "0",
        "7",
        "14",
        "30",
        "60",
        "90"
      ]
    },
    {
      "name": "timeout",
      "label": "Timeout (s)",
      "type": "number"
    }
  ]
}
