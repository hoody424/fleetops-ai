{
  "slug": "ssh",
  "name": "SSH",
  "icon": "Terminal",
  "category": "Remote Access",
  "check_type": "tcp",
  "inventory_match": ["openssh", "sshd", "ssh"],
  "defaults": {
    "port": 22,
    "timeout": 5,
    "response_pattern": "SSH-"
  },
  "fields": [
    {
      "name": "port",
      "label": "Port",
      "type": "number",
      "required": true
    },
    {
      "name": "timeout",
      "label": "Timeout (s)",
      "type": "number"
    }
  ]
}
