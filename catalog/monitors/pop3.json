{
  "slug": "pop3",
  "name": "POP3 / POP3S",
  "icon": "Inbox",
  "category": "Email",
  "check_type": "tcp",
  "inventory_match": ["pop3"],
  "defaults": {
    "port": 995,
    "timeout": 5,
    "ssl": true,
    "warn_days": 0,
    "response_pattern": "+OK",
    "starttls": "pop3"
  },
  "fields": [
    {
      "name": "port",
      "label": "Port",
      "type": "number",
      "required": true
    },
    {
      "name": "ssl",
      "label": "SSL / TLS",
      "type": "boolean"
    },
    {
      "name": "warn_days",
      "label": "Certificate Warning (days)",
      "type": "select",
      "options": [
        "0",
        "7",
        "14",
        "30",
        "60",
        "90"
      ]
    },
    {
      "name": "timeout",
      "label": "Timeout (s)",
      "type": "number"
    }
  ]
}
